# Countersign configuration.
#
#   cp .env.example .env
#   make keys        # fills the three *_JWK values
#
# Every variable without a default is required. The process refuses to start
# if any is missing — see src/config.ts. Secrets are read from the environment
# and never from CLI flags, because argv is visible to any user via `ps`.

# ─── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Our own origin. Becomes the `aud` of every mandate and the realm of every
# 402 challenge, so a mandate minted for another deployment cannot be replayed
# against this one. Must match the URL agents actually reach.
COUNTERSIGN_BASE_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://countersign:countersign@localhost:5432/countersign
DATABASE_POOL_MAX=10

# ─── Razorpay ─────────────────────────────────────────────────────────────
# TEST MODE ONLY. The service refuses to boot with an rzp_live_ key, and CI
# greps for one. Get these from Dashboard → Account & Settings → API Keys with
# the mode toggle set to Test.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_me_at_least_16_chars

# A DIFFERENT secret from the one above. Set when creating the webhook in the
# dashboard; signs the raw request body. Test-mode webhook setup OTP is 754081.
# Note that ngrok and webhook.site are blacklisted by Razorpay — use zrok.
RAZORPAY_WEBHOOK_SECRET=replace_me_at_least_16_chars

# Razorpay retries a failed webhook for 24 hours, so a delivery can legitimately
# arrive a day late. Stripe's usual 5-minute tolerance would reject exactly the
# retries this window exists to accept.
WEBHOOK_MAX_AGE_SECONDS=93600

# ─── The 402 challenge ────────────────────────────────────────────────────
# Derives the stateless challenge HMAC, the way P3P derives it from the PG
# client secret. Rotating this invalidates every outstanding challenge, which
# is fine — they live for minutes.
CHALLENGE_HMAC_SECRET=replace_me_at_least_16_chars
CHALLENGE_TTL_SECONDS=300

# ─── Signing keys (base64url JWK) ─────────────────────────────────────────
# Generate with: make keys
#
# These are on the box, in the environment, with no HSM and no KMS. That is a
# real limitation, stated in docs/LIMITATIONS.md rather than papered over:
# whoever holds CHECKPOINT_JWK can rebuild and re-sign the audit log.
#
# MANDATE_ISSUER_JWK  ES256 — stands in for the human's consent surface
# AGENT_SIGNING_JWK   ES256 — the buying agent's key, endorsed by the open mandate
# CHECKPOINT_JWK      Ed25519 — signs audit-log checkpoints
MANDATE_ISSUER_JWK=
AGENT_SIGNING_JWK=
CHECKPOINT_JWK=

OPEN_MANDATE_TTL_SECONDS=86400
CLOSED_MANDATE_TTL_SECONDS=120

# ─── Observability (optional) ─────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
