{
  "name": "countersign",
  "version": "0.1.0",
  "private": true,
  "description": "Merchant-side spend gate and offline verifier. Serves / and /agents.md as discovery documents; no catalog, ACP session, or MCP surface yet.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.11.0",
  "bin": {
    "countersign": "./dist/src/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/http/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/http/server.js",
    "test": "vitest run --project unit",
    "test:watch": "vitest watch --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "migrate": "tsx scripts/migrate.ts",
    "export": "tsx scripts/export-bundle.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "canonicalize": "^2.1.0",
    "fastify": "^5.7.1",
    "jose": "^6.2.9",
    "pino": "^10.1.0",
    "postgres": "^3.4.7",
    "ulid": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.2",
    "fast-check": "^4.5.0",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
