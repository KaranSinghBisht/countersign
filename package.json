{
  "name": "pramaan",
  "version": "0.1.0",
  "private": true,
  "description": "A merchant server an AI buyer can discover and buy from, that can prove the agent was never allowed outside its budget.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.11.0",
  "bin": {
    "pramaan": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/http/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/http/server.js",
    "test": "vitest run --project unit",
    "test:watch": "vitest watch --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "canonicalize": "^2.1.0",
    "fastify": "^5.7.1",
    "jose": "^6.2.9",
    "pino": "^10.1.0",
    "postgres": "^3.4.7",
    "ulid": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/node": "^24.10.1",
    "fast-check": "^4.5.0",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
